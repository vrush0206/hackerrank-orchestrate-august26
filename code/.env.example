# Copy this file to .env and replace the placeholder locally. Never commit .env.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.6-flash
# Free-tier default: four requests per minute, below a five RPM limit.
GEMINI_MIN_INTERVAL_MS=15000
GEMINI_MAX_REQUEST_FAILURES=2
DASHBOARD_PORT=3000
MESSAGE_BATCH_SIZE=10
# Set to 10 for a first-ten-real-messages test; leave 0 for the full dataset.
MESSAGE_LIMIT=0
